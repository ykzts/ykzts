{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 150
          }
        }
      },
      "style": {
        // Framework hooks such as Lexical's createDOM() and isInline() are
        // instance methods by contract even when they ignore `this`; mark them
        // `override` instead of turning the rule off.
        "useThisInClassMethods": {
          "level": "error",
          "options": {
            "ignoreOverrideMethods": true
          }
        }
      },
      "performance": {
        // All apps enable React Compiler, which auto-memoizes callbacks and
        // components. Requiring manual useCallback for every JSX prop is
        // noise and fights the compiler model.
        "noJsxPropsBind": "off"
      },
      "suspicious": {
        "noUnnecessaryConditions": "warn",
        "useBaseline": {
          "level": "error",
          "options": {
            // ::selection only styles highlighted text; browsers without it
            // fall back to their default highlight.
            "allowSelectors": ["selection"]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "!.agents/**/*",
      "!.devcontainer/devcontainer-lock.json",
      "!packages/ui/src/components/**/*.{ts,tsx}",
      "!skills-lock.json"
    ]
  },
  "tailwind": {
    // The shared theme every app imports. Without it, useTailwindSortedClasses
    // does not know the custom colors (bg-card, text-muted-foreground, ...)
    // and sorts them ahead of every built-in utility.
    "stylesheet": "./packages/ui/src/styles/theme.css"
  },
  "overrides": [
    {
      // Playwright has no it(); ultracite/biome/vitest asks for it() inside
      // describe(), which test.describe() cannot follow.
      "includes": ["apps/*/e2e/**"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTestIt": "off"
          }
        }
      }
    },
    {
      // Generated by `pnpm typegen` (Supabase CLI). Only format it so the
      // output is stable across CLI versions; linting and assists (e.g. key
      // sorting) would rewrite generated code.
      "assist": {
        "enabled": false
      },
      "includes": ["packages/supabase/src/database.types.ts"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
